NEXT_PUBLIC_API_URL=https://localhost:7298
VERCEL_OIDC_TOKEN=

# Vercel Blob store - used to upload TMDB poster images (see src/app/api/upload-image/route.ts)
# Add these to your local .env.local and to the Vercel project settings.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Production API (hosted on Railway) - used automatically when the app is
# deployed to Vercel in the production environment. Uncomment to force it:
# NEXT_PUBLIC_API_URL=https://lexiconmovieapi-production.up.railway.app